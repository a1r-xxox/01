--[[ 
    STRICT PHYSICAL DECOUPLING FLING
    - Limb is parented to workspace during attack to prevent body drag
    - Zero body movement (Body stays at OldPos)
    - No Chinese comments
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Player = Players.LocalPlayer

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "UltimateLimbFling"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = game:GetService("CoreGui")

local MainFrame = Instance.new("Frame")
MainFrame.Size = UDim2.new(0, 300, 0, 350)
MainFrame.Position = UDim2.new(0.5, -150, 0.5, -175)
MainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

local PlayerScrollFrame = Instance.new("ScrollingFrame")
PlayerScrollFrame.Position = UDim2.new(0, 10, 0, 40)
PlayerScrollFrame.Size = UDim2.new(1, -20, 0, 230)
PlayerScrollFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
PlayerScrollFrame.BorderSizePixel = 0
PlayerScrollFrame.Parent = MainFrame

local StartButton = Instance.new("TextButton")
StartButton.Position = UDim2.new(0, 10, 0, 280)
StartButton.Size = UDim2.new(0.5, -15, 0, 40)
StartButton.BackgroundColor3 = Color3.fromRGB(0, 120, 0)
StartButton.Text = "START FLING"
StartButton.TextColor3 = Color3.fromRGB(255, 255, 255)
StartButton.Parent = MainFrame

local StopButton = Instance.new("TextButton")
StopButton.Position = UDim2.new(0.5, 5, 0, 280)
StopButton.Size = UDim2.new(0.5, -15, 0, 40)
StopButton.BackgroundColor3 = Color3.fromRGB(120, 0, 0)
StopButton.Text = "STOP FLING"
StopButton.TextColor3 = Color3.fromRGB(255, 255, 255)
StopButton.Parent = MainFrame

local SelectedTargets = {}
local FlingActive = false

local function UltimateLimbFling(TargetPlayer)
    local Char = Player.Character
    local TChar = TargetPlayer.Character
    if not (Char and TChar) then return end

    local Root = Char:FindFirstChild("HumanoidRootPart")
    local TRoot = TChar:FindFirstChild("HumanoidRootPart") or TChar:FindFirstChild("Head")
    local Limb = Char:FindFirstChild("RightHand") or Char:FindFirstChild("Right Arm")
    local Hum = Char:FindFirstChildOfClass("Humanoid")

    if Limb and TRoot and Root and Hum then
        local OldCF = Root.CFrame
        local OriginalParent = Limb.Parent
        local Joint = Limb:FindFirstChildOfClass("Motor6D") or Limb:FindFirstChild("RightShoulder")
        
        -- 1. Total Decoupling
        if Joint then Joint.Enabled = false end
        Limb.Parent = workspace -- Move limb to workspace to block physics drag
        Root.Anchored = true -- Freeze body to be 100% sure
        workspace.FallenPartsDestroyHeight = 0/0

        local StartTime = tick()
        while tick() - StartTime < 1.5 and FlingActive and TChar.Parent do
            -- 2. Attack Target with Limb
            Limb.CanCollide = true
            Limb.CFrame = TRoot.CFrame * CFrame.Angles(math.rad(math.random(0,360)), math.rad(math.random(0,360)), math.rad(math.random(0,360)))
            Limb.Velocity = Vector3.new(0, 9e7, 0)
            Limb.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
            task.wait()
        end

        -- 3. Re-attach
        Limb.Velocity = Vector3.new()
        Limb.RotVelocity = Vector3.new()
        Limb.Parent = OriginalParent
        if Joint then Joint.Enabled = true end
        Root.Anchored = false
        Root.CFrame = OldCF
    end
end

local function Refresh()
    for _, v in pairs(PlayerScrollFrame:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    local y = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player then
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 30)
            btn.Position = UDim2.new(0, 0, 0, y)
            btn.Text = p.Name
            btn.BackgroundColor3 = SelectedTargets[p.Name] and Color3.fromRGB(100, 50, 50) or Color3.fromRGB(40, 40, 40)
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            btn.Parent = PlayerScrollFrame
            btn.MouseButton1Click:Connect(function()
                if SelectedTargets[p.Name] then SelectedTargets[p.Name] = nil else SelectedTargets[p.Name] = p end
                Refresh()
            end)
            y = y + 35
        end
    end
    PlayerScrollFrame.CanvasSize = UDim2.new(0, 0, 0, y)
end

StartButton.MouseButton1Click:Connect(function()
    if FlingActive then return end
    FlingActive = true
    task.spawn(function()
        while FlingActive do
            for _, p in pairs(SelectedTargets) do
                if FlingActive and p.Parent then UltimateLimbFling(p) end
            end
            task.wait(0.1)
        end
    end)
end)

StopButton.MouseButton1Click:Connect(function() FlingActive = false end)
Players.PlayerAdded:Connect(Refresh)
Players.PlayerRemoving:Connect(Refresh)
Refresh()
