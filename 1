local SelectedTargets = {}
local FlingActive = false

local function StrictLimbFling(TargetPlayer)
    local Character = Player.Character
    local TChar = TargetPlayer.Character
    if not (Character and TChar) then return end

    local Root = Character:FindFirstChild("HumanoidRootPart")
    local TRoot = TChar:FindFirstChild("HumanoidRootPart") or TChar:FindFirstChild("Head")
    local Limb = Character:FindFirstChild("RightHand") or Character:FindFirstChild("Right Arm")

    if Limb and TRoot and Root then
        local OldCF = Root.CFrame
        local Joint = Limb:FindFirstChildOfClass("Motor6D") or Limb:FindFirstChild("RightShoulder")
        
        -- 1. Detach Limb and Hide Body
        if Joint then Joint.Enabled = false end
        Root.CFrame = OldCF * CFrame.new(0, -50, 0)
        Limb.CanCollide = true
        workspace.FallenPartsDestroyHeight = 0/0

        local StartTime = tick()
        while tick() - StartTime < 1.5 and FlingActive and TChar.Parent do
            -- 2. Only Move the Limb to Target
            Limb.CFrame = TRoot.CFrame * CFrame.Angles(math.rad(math.random(0,360)), math.rad(math.random(0,360)), math.rad(math.random(0,360)))
            Limb.Velocity = Vector3.new(0, 9e7, 0)
            Limb.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
            task.wait()
        end

        -- 3. Reset
        if Joint then Joint.Enabled = true end
        Limb.Velocity, Limb.RotVelocity = Vector3.new(), Vector3.new()
        Root.CFrame = OldCF
    end
end

local function Refresh()
    for _, v in pairs(PlayerScrollFrame:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    local y = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player then
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 30)
            btn.Position = UDim2.new(0, 0, 0, y)
            btn.Text = p.Name
            btn.BackgroundColor3 = SelectedTargets[p.Name] and Color3.fromRGB(100, 50, 50) or Color3.fromRGB(60, 60, 60)
            btn.Parent = PlayerScrollFrame
            btn.MouseButton1Click:Connect(function()
                if SelectedTargets[p.Name] then SelectedTargets[p.Name] = nil else SelectedTargets[p.Name] = p end
                Refresh()
            end)
            y = y + 35
        end
    end
    PlayerScrollFrame.CanvasSize = UDim2.new(0, 0, 0, y)
end

StartButton.MouseButton1Click:Connect(function()
    FlingActive = true
    task.spawn(function()
        while FlingActive do
            for _, p in pairs(SelectedTargets) do
                if FlingActive then StrictLimbFling(p) end
            end
            task.wait(0.2)
        end
    end)
end)

StopButton.MouseButton1Click:Connect(function() FlingActive = false end)
Players.PlayerAdded:Connect(Refresh)
Players.PlayerRemoving:Connect(Refresh)
Refresh()
